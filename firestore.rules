rules_version = '2';
// חוקי האבטחה של הבקרה (ט.ש. מי-רון) — מדביקים ב-Firebase Console ← Firestore ← Rules ← Publish
//
// תפקידים (במסמך staff/{+9725…}, שדה role):
//   office — משרד: קורא וכותב הכול
//   mgr    — מנהל פרויקט: קורא הכול, כותב רק באתרים שלו (+ requests/transfers/nudges/since/log)
//   viewer — צופה: קורא כל מה שהמשרד קורא, לא כותב שום דבר, לא רואה את רשימת המשתמשים
//   agency — חברת כוח אדם (staff.agency = מזהה החברה): קוראת רק את דוחות השעות הנעולים שלה ומאשרת/משיגה עליהם.
//            לא נחשבת "צוות" — לא קוראת שום נתון אחר (אתרים, עובדים, רישומים, תמונות, משתמשים)
//   עובד   — כניסה אנונימית מקישור אישי. מקושר לעובד אחד בלבד (workers/{w}.uid == ה-uid שלו)
service cloud.firestore {
  match /databases/{db}/documents {

    // ───── זהות ותפקיד ─────
    function authed()   { return request.auth != null; }
    function hasPhone() { return authed() && request.auth.token.get('phone_number', null) != null; }
    function phone()    { return request.auth.token.phone_number; }
    function staffRef() { return /databases/$(db)/documents/staff/$(phone()); }
    function isMember() { return hasPhone() && exists(staffRef()) && get(staffRef()).data.get('active', true) != false; }
    function role()     { return get(staffRef()).data.get('role', ''); }
    // צוות פנימי: משרד, מנהל, צופה. חברת כ״א לא נכללת — כל חוקי הקריאה והכתיבה הרגילים עוברים דרך כאן
    function isStaff()  { return isMember() && role() != 'agency'; }
    function isAgency() { return isMember() && role() == 'agency'; }
    function myAgency() { return get(staffRef()).data.agency; }
    function isOffice() { return isStaff() && role() == 'office'; }
    function isViewer() { return isStaff() && role() == 'viewer'; }
    // מי שמותר לו לכתוב: משתמש פעיל שאינו צופה. כל חוקי הכתיבה של המנהלים עוברים דרך כאן
    function canWrite() { return isStaff() && role() != 'viewer'; }
    function myName()   { return get(staffRef()).data.name; }
    function isOwner()  { return hasPhone() && get(/databases/$(db)/documents/staffmeta/owner).data.phone == phone(); }

    // ───── אתרים ומנהלים ─────
    function isAtt(space) { return get(/databases/$(db)/documents/t/$(space)/meta/space).data.kind == 'att'; }
    function ownerOf(d)   { return d.owner is map ? d.owner.name : d.owner; }
    // מנהל ראשי (owner) או מנהל נוסף (mgrs) של האתר
    function manages(d)   { return ownerOf(d) == myName() || myName() in d.get('mgrs', []); }
    function ownsSite(space, sid) { return manages(get(/databases/$(db)/documents/t/$(space)/sites/$(sid)).data); }
    function ownsWorker(space, wid) { return ownsSite(space, get(/databases/$(db)/documents/t/$(space)/workers/$(wid)).data.site); }

    // ───── עובד (כניסה אנונימית) ─────
    // העובד מקושר לטלפון שלו: בפתיחה הראשונה של הקישור נשמר ב-workers/{w}.uid ה-uid האנונימי של הטלפון
    // רק כניסה אנונימית (הטלפון של העובד). משתמש עם מספר טלפון — משרד, מנהל או צופה — לא פועל כעובד
    function isAnon() { return authed() && request.auth.token.firebase.sign_in_provider == 'anonymous'; }
    function workerDoc(space, wid) { return get(/databases/$(db)/documents/t/$(space)/workers/$(wid)); }
    function myWorker(space, wid)  { return workerDoc(space, wid).data.get('uid', null) == request.auth.uid; }
    // מזהה רישום/תמונה: yyyymmdd_<עובד>_<5 תווים> — קושר את המסמך לעובד שלו
    function punchId(id, wid) { return id.matches('[0-9]{8}_' + wid + '_[A-Za-z0-9]{5}'); }

    // ───── דוחות שעות לחברות כ״א ─────
    // agreports/{חברה}_{תחילת שבוע}   — הגרסה האחרונה שנעלה המשרד (לא נמחקת לעולם)
    // agreportsv/{דוח}_v{n}           — עותק מדויק של כל גרסה שהוחלפה (נוצר פעם אחת, לא משתנה ולא נמחק)
    // agacks/{דוח}_v{n}               — אישור/השגה של החברה לגרסה מסוימת (נוצר פעם אחת, לא משתנה ולא נמחק)
    function agColl(coll) { return coll in ['agreports', 'agreportsv', 'agacks']; }
    function repPath(space, rid) { return /databases/$(db)/documents/t/$(space)/agreports/$(rid); }

    match /staffmeta/owner {
      allow read: if hasPhone() && !isAgency();
      allow create: if hasPhone() && request.resource.data.phone == phone();
    }
    match /staff/{p} {
      // כל אחד קורא את המסמך של עצמו. משרד ומנהלים — גם של אחרים (כמו היום). צופה — רק את עצמו
      allow get: if hasPhone() && (p == phone() || canWrite());
      allow list: if isOffice();
      allow write: if isOffice() || isOwner();
    }

    match /t/{space}/{coll}/{id} {
      // ── קריאה: כל משתמש פעיל (משרד, מנהל, צופה) — חוץ מחשבונות הביצוע ──
      allow read: if isStaff() && coll != 'bills';
      // חשבון ביצוע של אתר (bills/{אתר}, כולל מחירים ויעד חודשי): משרד, צופה, ומנהלי האתר בלבד.
      // רק get (לא list) — מנהל לא יכול לשלוף את כל החשבונות בשאילתה. כתיבה — משרד בלבד (החוק הכללי למטה)
      allow get: if coll == 'bills' && (isOffice() || isViewer() || (isStaff() && ownsSite(space, id)));
      allow list: if coll == 'bills' && (isOffice() || isViewer());
      // ── כתיבה: משרד (חוץ מדוחות כ״א, שיש להם חוקים משלהם למטה) ──
      allow write: if !agColl(coll) && isOffice();

      // ── דוחות שעות לחברות כ״א ──
      // נעילה ראשונה: גרסה 1
      allow create: if coll == 'agreports' && isOffice()
                    && request.resource.data.id == id && request.resource.data.version == 1
                    && request.resource.data.ag is string && id.matches(request.resource.data.ag + '_[0-9-]{10}');
      // נעילה חוזרת: גרסה +1, ורק אם הגרסה הקודמת נשמרה באותה פעולה ב-agreportsv
      allow update: if coll == 'agreports' && isOffice()
                    && request.resource.data.id == id && request.resource.data.ag == resource.data.ag
                    && request.resource.data.version == resource.data.version + 1
                    && existsAfter(/databases/$(db)/documents/t/$(space)/agreportsv/$(id + '_v' + string(resource.data.version)));
      // ארכיון גרסה: עותק זהה לגרסה הנוכחית (לפני העדכון), במזהה שלה
      allow create: if coll == 'agreportsv' && isOffice()
                    && request.resource.data == get(repPath(space, request.resource.data.id)).data
                    && id == request.resource.data.id + '_v' + string(request.resource.data.version);
      // החברה קוראת רק את הדוחות, הגרסאות והאישורים שלה
      allow read: if agColl(coll) && isAgency() && resource.data.ag == myAgency();
      allow get: if coll == 'agencies' && isAgency() && id == myAgency();
      // אישור/השגה: רק לגרסה הנוכחית של דוח שלה, פעם אחת לכל גרסה, עם שעת שרת ושם החותם
      allow create: if coll == 'agacks' && isAgency()
                    && request.resource.data.keys().hasOnly(['id', 'rep', 'ag', 'version', 'status', 'note', 'by', 'phone', 'at'])
                    && request.resource.data.id == id
                    && request.resource.data.ag == myAgency()
                    && get(repPath(space, request.resource.data.rep)).data.ag == myAgency()
                    && request.resource.data.version == get(repPath(space, request.resource.data.rep)).data.version
                    && id == request.resource.data.rep + '_v' + string(request.resource.data.version)
                    && request.resource.data.status in ['approved', 'disputed']
                    && request.resource.data.note is string && request.resource.data.note.size() <= 1000
                    && (request.resource.data.status == 'approved' || request.resource.data.note.size() >= 3)
                    && request.resource.data.by == myName()
                    && request.resource.data.phone == phone()
                    && request.resource.data.at == request.time;

      // ── כתיבה: מנהל פרויקט (צופה לא נכלל — canWrite) ──
      allow update: if coll == 'sites' && canWrite()
                    && manages(resource.data) && manages(request.resource.data);
      allow write: if coll in ['requests', 'transfers', 'nudges', 'since'] && canWrite();
      allow create: if coll == 'log' && canWrite();
      allow create, update: if coll == 'photos' && canWrite() && ownsSite(space, request.resource.data.siteId);
      allow delete: if coll == 'photos' && canWrite() && ownsSite(space, resource.data.siteId);

      allow create: if coll == 'workers' && canWrite() && ownsSite(space, request.resource.data.site);
      allow update: if coll == 'workers' && canWrite()
                    && ownsSite(space, resource.data.site) && ownsSite(space, request.resource.data.site);
      allow create: if coll == 'fix' && canWrite() && ownsWorker(space, request.resource.data.w);
      // אישור טלפון חדש לעובד (rel): המנהל של העובד סוגר בקשה פתוחה — רק סטטוס, שם (שלו) ושעה
      allow update: if coll == 'rel' && canWrite() && ownsWorker(space, resource.data.w)
                    && resource.data.status == 'open'
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'by', 'doneAt'])
                    && request.resource.data.status in ['done', 'rejected', 'dup']
                    && request.resource.data.by == myName();
      // ניתוק ידני (📱✕) נרשם ביומן על שם המנהל
      allow create: if coll == 'rel' && canWrite() && ownsWorker(space, request.resource.data.w)
                    && request.resource.data.status == 'manual' && request.resource.data.by == myName();
      allow write: if coll == 'ref' && canWrite() && ownsWorker(space, id);

      // ── עובד (כניסה אנונימית בלבד), רק במרחב הנוכחות ──
      // מסמך העובד: רק העובד המקושר אליי, או עובד חדש שעוד לא נקשר לשום טלפון. מסמך שלא קיים — מותר (כדי להציג "קישור לא תקין")
      allow get: if coll == 'workers' && isAnon() && isAtt(space)
                 && (resource == null
                     || resource.data.get('uid', null) == request.auth.uid
                     || (resource.data.get('uid', null) == null && resource.data.get('dev', null) == null));
      // אתרים — שם ומיקום לבחירת אתר ולמדידת מרחק
      allow read: if coll == 'sites' && isAnon() && isAtt(space);
      // רישומי כניסה/יציאה — רק של העובד המקושר אליי
      allow read: if coll == 'punch' && isAnon() && isAtt(space) && myWorker(space, resource.data.w);
      // קישור הטלפון לעובד ועדכון השדות שלו:
      //   • עובד שכבר מקושר אליי — מעדכן dev/devAt/hasRef
      //   • עובד שעוד לא מקושר — נקשר אליי אם הוא חדש (בלי טלפון), או אם זה אותו טלפון שנקשר בגרסה הקודמת (אותו dev)
      //   המנהל משחרר טלפון עם 📱✕ (dev ו-uid מתאפסים) — ואז הטלפון הבא שפותח את הקישור נקשר
      allow update: if coll == 'workers' && isAnon() && isAtt(space)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dev', 'devAt', 'hasRef', 'uid'])
                    && request.resource.data.get('uid', null) == request.auth.uid
                    && (resource.data.get('uid', null) == request.auth.uid
                        || (resource.data.get('uid', null) == null
                            && (resource.data.get('dev', null) == null
                                || resource.data.get('dev', null) == request.resource.data.get('dev', null))));
      // בקשה לאשר את הטלפון הזה (הקישור מחובר לטלפון אחר). העובד לא קורא את הבקשות — רק יוצר
      allow create: if coll == 'rel' && isAnon() && isAtt(space)
                    && request.resource.data.keys().hasOnly(['id', 'w', 'uid', 'dev', 'status', 'at', 'ua'])
                    && request.resource.data.id == id
                    && request.resource.data.w is string
                    && id.matches(request.resource.data.w + '_[A-Za-z0-9]{5}')
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.dev is string && request.resource.data.dev.size() <= 40
                    && request.resource.data.ua is string && request.resource.data.ua.size() <= 200
                    && request.resource.data.status == 'open'
                    && request.resource.data.at == request.time
                    && exists(/databases/$(db)/documents/t/$(space)/workers/$(request.resource.data.w));
      // רישום כניסה/יציאה — רק לעובד המקושר אליי, עם שעת שרת ושדות מוכרים בלבד
      allow create: if coll == 'punch' && isAnon() && isAtt(space)
                    && request.resource.data.keys().hasOnly(['id', 'w', 'name', 'site', 'siteName', 'type', 'day', 'dts', 'ts',
                                                            'lat', 'lng', 'acc', 'gpsErr', 'dev', 'off', 'cam', 'ua', 'v'])
                    && request.resource.data.id == id
                    && request.resource.data.w is string
                    && punchId(id, request.resource.data.w)
                    && request.resource.data.ts == request.time
                    && request.resource.data.type in ['in', 'out']
                    && myWorker(space, request.resource.data.w);
      // סלפי של רישום — רק לעובד המקושר אליי, באותו מזהה של הרישום, תמונה בלבד ובגודל סביר
      allow create: if coll == 'pph' && isAnon() && isAtt(space)
                    && request.resource.data.keys().hasOnly(['id', 'w', 'day', 'site', 'url'])
                    && request.resource.data.id == id
                    && request.resource.data.w is string
                    && punchId(id, request.resource.data.w)
                    && request.resource.data.day is string && request.resource.data.day.size() == 10
                    && request.resource.data.site is string && request.resource.data.site.size() <= 40
                    && request.resource.data.url is string && request.resource.data.url.size() < 600000
                    && request.resource.data.url.matches('data:image/[a-z]+;base64,.*')
                    && myWorker(space, request.resource.data.w);
      // תמונת זיהוי אוטומטית (הסלפי הראשון) — רק לעובד המקושר אליי, פעם אחת
      allow create: if coll == 'ref' && isAnon() && isAtt(space)
                    && myWorker(space, id)
                    && request.resource.data.keys().hasOnly(['w', 'url', 'pid', 'at', 'by'])
                    && request.resource.data.w == id
                    && request.resource.data.by == 'auto'
                    && request.resource.data.url is string && request.resource.data.url.size() < 600000;
    }
    // תתי-אוספים (רמה אחת לפחות מתחת למסמך — {rest=**} לבד תופס גם את המסמך עצמו)
    match /t/{space}/{coll}/{id}/{sub}/{rest=**} {
      allow read: if isOffice() || isViewer();
      allow write: if isOffice();
    }

    // ───── מסמכים אישיים (תלושי שכר, הפרשות, 106, חוזה, רכב והוצאות) ─────
    // מחוץ ל-t/ בכוונה: החוק הכללי שם נותן קריאה לכל הצוות.
    //   pdocs/{טלפון}                        — כרטיס: שם מלא, מספר עובד, ת.ז. מגובבת (SHA-256), החודש האחרון לכל סוג
    //   pdocs/{טלפון}/files/{מסמך}           — פרטי המסמך (סוג, תקופה, שם קובץ, גודל, נקרא)
    //   pdocs/{טלפון}/files/{מסמך}/parts/{i} — תוכן הקובץ, בחלקים
    // קוראים: בעל המספר עצמו (משתמש פעיל) והמשרד בלבד. צופה, מנהלים אחרים וחברות כ״א — לא.
    // כותבים: המשרד בלבד. בעל המסמך רק מסמן "נקרא" (שעת שרת)
    function mine(p) { return isMember() && p == phone(); }
    match /pdocs/{p} {
      allow read: if mine(p) || isOffice();
      allow write: if isOffice();
    }
    match /pdocs/{p}/files/{f} {
      allow read: if mine(p) || isOffice();
      allow write: if isOffice();
      allow update: if mine(p)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen'])
                    && request.resource.data.seen == request.time;
    }
    match /pdocs/{p}/files/{f}/parts/{i} {
      allow read: if mine(p) || isOffice();
      allow write: if isOffice();
    }

    // ───── חשבוניות ספקים ─────
    // מחוץ ל-t/ בכוונה (שם כל הצוות קורא). תהליך הקליטה מהמייל כותב עם הרשאת שרת — לא עובר כאן.
    //   inv/{id}            — פרטי החשבונית          inv/{id}/parts/{i} — תוכן הקובץ
    //   invsup/{id}         — כרטיסי ספקים           invmeta/{cfg|mail}  — הגדרות ומצב הקליטה
    // המשרד: קורא וכותב הכול. מנהל פרויקט: קורא רק חשבוניות שנשלחו אליו (pm == השם שלו),
    // ומעדכן רק את האישור שלו — כשהחשבונית ממתינה לו: מאשר (→ tal) או דוחה (→ rej)
    function invPm(d) { return canWrite() && d.get('pm', '') == myName(); }
    match /inv/{id} {
      allow read: if isOffice() || invPm(resource.data);
      allow write: if isOffice();
      allow update: if invPm(resource.data) && resource.data.status == 'pm'
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'pmBy', 'pmAt', 'pmNote'])
                    && request.resource.data.status in ['tal', 'rej']
                    && request.resource.data.pmBy == myName()
                    && request.resource.data.pmAt == request.time
                    && request.resource.data.pmNote is string && request.resource.data.pmNote.size() <= 500
                    && (request.resource.data.status == 'tal' || request.resource.data.pmNote.size() > 0);
    }
    match /inv/{id}/parts/{i} {
      allow read: if isOffice() || invPm(get(/databases/$(db)/documents/inv/$(id)).data);
      allow write: if isOffice();
    }
    match /invsup/{id} {
      allow read, write: if isOffice();
    }
    match /invmeta/{k} {
      allow read, write: if isOffice();
    }
  }
}
